# Server Port
PORT=3000

# Server Mode: "simulation" or "hardware"
MODE=simulation

# Security API Key (Sent via 'x-api-key' header)
API_KEY=jarvis_secure_token_8899

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500,capacitor://localhost,http://localhost

# Hardware Mode Serial Port (leave blank for auto-detection)
ARDUINO_PORT=
ARDUINO_BAUD=9600
